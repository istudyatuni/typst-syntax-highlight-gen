{
	"as": {
		"matches": ["actionscript"],
		"scope": "source.actionscript.2"
	},
	"bat": {
		"scope": "source.dosbatch"
	},
	"clj": {
		"matches": ["clojure"],
		"scope": "source.clojure"
	},
	"cpp": {
		"scope": "source.c++"
	},
	"erl": {
		"scope": "source.erlang"
	},
	"hs": {
		"matches": ["haskell"],
		"scope": "source.haskell"
	},
	"html": {
		"scope": "text.html.basic"
	},
	"js": {
		"matches": ["javascript"]
	},
	"jsp": {
		"scope": "text.html.jsp"
	},
	"make": {
		"scope": "source.makefile"
	},
	"ml": {
		"matches": ["ocaml"],
		"scope": "source.ocaml"
	},
	"pl": {
		"scope": "source.perl"
	},
	"py": {
		"scope": "source.python"
	},
	"rb": {
		"scope": "source.ruby"
	},
	"re": {
		"scope": "source.regexp"
	},
	"rs": {
		"scope": "source.rust"
	},
	"sh": {
		"scope": "source.shell.bash"
	},
	"tex": {
		"scope": "text.tex.latex"
	},
	"xml": {
		"scope": "text.xml"
	}
}
